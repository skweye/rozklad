{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newrozklad",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "AUTH_SITE_ORIGIN": "https://newrozklad.pp.ua",
    "MAIN_ADMIN_EMAIL": "ym_hryzhenko_081205@dtsepaton.ukr.education"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "newrozklad",
    // Replace with the ID returned by: npx wrangler d1 create newrozklad
    "database_id": "d1a1037a-5c06-4671-84d1-61f68b201acd",
    "migrations_dir": "migrations"
  }]
}
