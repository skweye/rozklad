{
  "name": "study-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "dev": "npm run build && wrangler dev --port 8787 --var AUTH_SITE_ORIGIN:http://localhost:8787",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "npm run build && wrangler deploy --dry-run --outdir .wrangler/check",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "google-auth-library": "11.1.0"
  },
  "devDependencies": {
    "wrangler": "4.143.0"
  }
}
